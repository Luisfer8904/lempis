# ============================================
#   ARCHIVO DE EJEMPLO - copia a .env y edita
# ============================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga
APP_HOST=0.0.0.0
APP_PORT=5000

# --- Base de datos ---
# Por defecto se usa SQLite local (no necesitas instalar PostgreSQL para desarrollo).
# Para activar PostgreSQL, descomenta la línea de abajo y crea la DB:
# DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5432/saas_facturacion

# --- Sesión / Cookies ---
SESSION_COOKIE_SECURE=False           # True en producción (HTTPS)
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME_DAYS=7

# --- Email (transaccional) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=no-reply@tudominio.com

# --- Stripe (suscripciones) ---
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx

# --- Branding / SaaS ---
APP_NAME=Lempis
APP_DOMAIN=localhost:5000
SUPPORT_EMAIL=soporte@tudominio.com

# --- Multi-tenant ---
TENANT_RESOLVER=subdomain    # opciones: subdomain | session | header
DEFAULT_LOCALE=es
DEFAULT_COUNTRY=HN
DEFAULT_CURRENCY=HNL

# --- Rate limiting ---
RATELIMIT_DEFAULT=200 per hour
