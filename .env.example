# ============================================
#   ARCHIVO DE EJEMPLO - copia a .env y edita
# ============================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga
APP_HOST=0.0.0.0
APP_PORT=5001  # 5000 está ocupado en macOS por AirPlay Receiver

# --- Base de datos ---
# LOCAL: si no defines DATABASE_URL, usa SQLite automáticamente (sin instalar nada).
#
# PRODUCCIÓN (Lightsail MySQL): formato:
#   DATABASE_URL=mysql://USUARIO:PASSWORD@HOST:3306/lempis_db
# Ejemplo:
# DATABASE_URL=mysql://lempis_user:tu_pass@ls-xxxxx.cmpokeawm2j7.us-east-1.rds.amazonaws.com:3306/lempis_db

# --- Sesión / Cookies ---
SESSION_COOKIE_SECURE=False           # True en producción (HTTPS)
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME_DAYS=7

# --- Email (transaccional) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=no-reply@tudominio.com

# --- Stripe (suscripciones) ---
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx

# --- Branding / SaaS ---
APP_NAME=Lempis
APP_DOMAIN=lempis.com
SUPPORT_EMAIL=soporte@lempis.com

# --- Multi-tenant ---
TENANT_RESOLVER=session    # opciones: subdomain | session | header (usa "session" en local)
DEFAULT_LOCALE=es
DEFAULT_COUNTRY=HN
DEFAULT_CURRENCY=HNL

# --- Rate limiting ---
RATELIMIT_DEFAULT=200 per hour
